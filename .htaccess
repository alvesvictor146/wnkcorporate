# ==============================================================================
# WNK CORPORATE - CONFIGURAÇÃO APACHE / HOSTGATOR (.htaccess)
# ==============================================================================

# 1. FORÇAR HTTPS E CANONICAL WWW (https://www.wnkcorporate.com.br)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Força HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Força www.wnkcorporate.com.br se acessado sem www (opcional e recomendado)
  RewriteCond %{HTTP_HOST} ^wnkcorporate\.com\.br$ [NC]
  RewriteRule ^(.*)$ https://www.wnkcorporate.com.br/$1 [L,R=301]
</IfModule>

# 2. COMPACTAÇÃO GZIP / BROTLI (Desempenho e velocidade)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 3. CACHE DE NAVEGADOR (Expiração de Estáticos)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML
  ExpiresByType text/html "access plus 1 hour"

  # CSS e JavaScript
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"

  # Imagens e Mídia
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"

  # Fontes
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>

# 4. CABEÇALHOS DE SEGURANÇA
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 5. PÁGINA DE ERRO CUSTOMIZADA (fallback para index.html se não encontrado)
ErrorDocument 404 /index.html
